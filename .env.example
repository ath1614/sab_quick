# ── Supabase (required) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC. Used by the image upload route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudinary (image upload route) ───────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── App ───────────────────────────────────────────────────────────────
# Public base URL of the deployment (used for auth email redirects).
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Set to "true" ONLY in local/dev to show the one-click demo role logins.
# Leave UNSET in production.
NEXT_PUBLIC_ENABLE_DEMO=

# ── Payments: Razorpay (optional — COD works without these) ───────────
# Online payment UI appears only when NEXT_PUBLIC_RAZORPAY_KEY_ID is set.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set the same value in the Razorpay dashboard webhook config
# pointing at https://your-app.vercel.app/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=
